# NSV SENTINEL Environment Configuration

# Application Mode & Environment
PROJECT_NAME="NSV SENTINEL"
API_V1_STR="/api/v1"
DEBUG=True
ENVIRONMENT="development"

# Database Configuration (PostgreSQL / SQLite fallback for dev)
DATABASE_URL="sqlite:///./nsv_sentinel.db"
# DATABASE_URL="postgresql://sentinel_user:sentinel_pass@localhost:5432/nsv_sentinel"

# Security & Authentication
# JWT Secret Key (Generate strong 256-bit key in production)
JWT_SECRET="nsv_sentinel_super_secret_jwt_key_2026_academic_prototype_change_in_prod"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AES-256-GCM Application Encryption Key (Must be exactly 32 bytes or 64 hex chars)
AES_SECRET_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# CORS Configuration
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# NewsAPI Configuration (Live News Feed for FinBERT sentiment)
NEWS_API_KEY=""
NEWS_API_BASE_URL="https://newsapi.org/v2"

# Dhan HQ API Integration (Live Market Feed)
DHAN_CLIENT_ID="1114191288"
DHAN_ACCESS_TOKEN="your_dhan_access_token"
