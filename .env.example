# ==============================================================================
# NSV SENTINEL Frontend Environment Configuration
# ==============================================================================

# Backend API Base URL
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# ------------------------------------------------------------------------------
# Firebase Authentication Configuration (100% Free - Sends Real Emails)
# ------------------------------------------------------------------------------
# How to get your keys in 2 minutes:
# 1. Open https://console.firebase.google.com and sign in with your Google Account
# 2. Click "Add project" and name it (e.g., "nsv-sentinel")
# 3. Go to "Authentication" > "Sign-in method" > Enable "Email/Password"
# 4. In Project Settings (gear icon) > "General" > scroll down to "Your apps" > click Web (</>)
# 5. Copy the firebaseConfig values and paste them below:
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
